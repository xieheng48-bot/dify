# 这些变量需在启动进程前设置；程序不会自动读取 .env 文件。
COMMERCE_DB=commerce.db
# 仅本地演示身份，部署时必须改为真实身份认证。
DEMO_USER_TOKENS={"demo-alice":"alice","demo-bob":"bob"}
# Dify 共享工具密钥只能查询政策，不能冒充用户访问订单或创建工单。
DIFY_TOOL_TOKEN=demo-dify-tools
# Dify 后端实际访问本服务的地址；Dify 在 Docker Desktop 内时可改为 http://host.docker.internal:8011。
DIFY_TOOL_BASE_URL=http://127.0.0.1:8011
# 留空则使用离线规则模式，不调用大模型。
DIFY_API_BASE=
DIFY_API_KEY=
